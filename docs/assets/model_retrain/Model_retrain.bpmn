<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Retrain" targetNamespace="https://github.com/ksdergach/db-monitoring-production-standards/bpmn/retrain" exporter="DB Monitor homework diagram builder" exporterVersion="1.0" expressionLanguage="urn:db-monitor:descriptive-conditions">
  <bpmn:error id="Error_Rejected" name="Публикация отклонена" errorCode="RetrainRejected"/>
  <bpmn:process id="Process_Retrain" name="Переобучение модели DB Monitor" isExecutable="false">
    <bpmn:documentation>Предлагаемый процесс. Не подключён к BPMN-движку. Условия и расписание описательные. Обязательное сравнение ROC-AUC на независимом размеченном контроле, дополнительные проверки и валидация человеком предшествуют публикации. Внешний диспетчер должен предотвращать конкурентные попытки для одной пары; обычные запросы и сигнал дрейфа не запускают повтор в режиме отказа. Ошибки сервисных задач должны быть отображены в BPMN Error; такая интеграция пока не реализована.</bpmn:documentation>
    <bpmn:startEvent id="Start_Timer" name="Каждую ночь&#10;в 04:00">
      <bpmn:documentation>Часовой пояс планировщика сервера. Для каждой пары создаётся отдельный экземпляр процесса.</bpmn:documentation>
      <bpmn:outgoing>Process_Retrain_F01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Start_Timer_Definition">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">Ежедневно в 04:00 по часовому поясу планировщика</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Manual" name="Явный ручной&#10;запуск">
      <bpmn:outgoing>Process_Retrain_F02</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Missing" name="Нет модели;&#10;нет режима отказа">
      <bpmn:outgoing>Process_Retrain_F03</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Start_Missing_Definition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Нет модели; нет режима отказа</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Change" name="Подтверждён дрейф;&#10;нет режима отказа">
      <bpmn:documentation>Предлагаемый внешний мониторинг подтверждает дрейф распределения данных по согласованному правилу, например с помощью PSI/KS. Порог задаётся для проекта заранее. Это отдельный триггер, не переименование точки излома. После отказа повтор разрешён только ночью или вручную.</bpmn:documentation>
      <bpmn:outgoing>Process_Retrain_F04</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Start_Change_Definition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Подтверждён дрейф; нет режима отказа</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Merge_Start" gatewayDirection="Converging">
      <bpmn:incoming>Process_Retrain_F01</bpmn:incoming>
      <bpmn:incoming>Process_Retrain_F02</bpmn:incoming>
      <bpmn:incoming>Process_Retrain_F03</bpmn:incoming>
      <bpmn:incoming>Process_Retrain_F04</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Inspect" name="1. Определить состояние&#10;и зафиксировать контекст" implementation="##unspecified">
      <bpmn:documentation>Определить фактическую активную версию и режим отказа. Зафиксировать прежнюю модель и контекст попытки. Окно пересчёта здесь ещё не задаётся: оно фиксируется после решения инженера перед переключением. При повторе восстановления использовать сохранённый контекст. Ошибку чтения передать как BPMN Error.</bpmn:documentation>
      <bpmn:incoming>Process_Retrain_F05</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Inspect_Error" name="Ошибка" attachedToRef="Inspect" cancelActivity="true">
      <bpmn:outgoing>Process_Retrain_F07</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Inspect_Error_Definition"/>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Pending" name="Восстановление&#10;не завершено?" gatewayDirection="Diverging" default="Process_Retrain_F08">
      <bpmn:incoming>Process_Retrain_F06</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F08</bpmn:outgoing>
      <bpmn:outgoing>Process_Retrain_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_Failure" gatewayDirection="Converging">
      <bpmn:incoming>Process_Retrain_F07</bpmn:incoming>
      <bpmn:incoming>Process_Retrain_F09</bpmn:incoming>
      <bpmn:incoming>Process_Retrain_F12</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Publish" name="2–7. Подготовить кандидата,&#10;проверить и опубликовать&#10;Подробности — схема 02">
      <bpmn:documentation>Встроенный подпроцесс. Только успешное завершение разрешает успешный конец основного процесса. Ошибки и отклонения передаются граничному событию.</bpmn:documentation>
      <bpmn:incoming>Process_Retrain_F08</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F10</bpmn:outgoing>
      <bpmn:laneSet id="Publish_Lanes">
        <bpmn:lane id="Lane_Auto" name="Автоматизация DB Monitor">
          <bpmn:flowNodeRef>P_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Data</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Data_OK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Train</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Quality</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Quality_OK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Register</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Window</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Deploy</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Scores</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Coherent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Resume</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_End</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_RejectData</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_RejectQuality</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_RejectScores</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Human" name="Инженер / владелец модели">
          <bpmn:flowNodeRef>P_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_Approved</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P_RejectHuman</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="P_Start" name="Вход из схемы 01">
        <bpmn:outgoing>Publish_F01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="P_Data" name="2. Подготовить признаки&#10;и независимый&#10;размеченный контроль" implementation="##unspecified">
        <bpmn:documentation>Признаки row_count, null_rate, d_row_count, d_null_rate; история обучения из окна 60 дней. Проверить конечность чисел и диапазоны. После отделения контроля минимум 200 строк обучающих признаков. Контроль содержит оба класса: нормальные точки и известные аномалии. Он не входит в обучение ни кандидата, ни прежней модели; происхождение и границы выборок подтверждены. Отделение последних 14 дней только от нового обучения не доказывает независимость от прежней модели. Без независимой разметки или утверждённого до оценки AUC_min отказ от публикации.</bpmn:documentation>
        <bpmn:incoming>Publish_F01</bpmn:incoming>
        <bpmn:outgoing>Publish_F02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_Data_OK" name="Данные и разметка&#10;пригодны и достаточны?" gatewayDirection="Diverging" default="Publish_F04">
        <bpmn:incoming>Publish_F02</bpmn:incoming>
        <bpmn:outgoing>Publish_F03</bpmn:outgoing>
        <bpmn:outgoing>Publish_F04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P_Train" name="3. Обучить кандидата:&#10;StandardScaler +&#10;Isolation Forest" implementation="##unspecified">
        <bpmn:documentation>Обучить новую пару модель + scaler отдельно от рабочего файла. Предыдущую версию сохранить.</bpmn:documentation>
        <bpmn:incoming>Publish_F03</bpmn:incoming>
        <bpmn:outgoing>Publish_F05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Quality" name="4. Рассчитать ROC-AUC;&#10;сравнить две версии;&#10;проверить сценарии" implementation="##unspecified">
        <bpmn:documentation>Согласованное правило допуска, 1 ноября 2026 года.
Сравниваются прежняя пригодная версия Isolation Forest и новый кандидат для одной пары «проект, таблица», каждый со своим StandardScaler.
Обе модели оценивают одни и те же независимые контрольные точки с заранее известными метками: 0 — норма, 1 — аномалия. Контроль не входит в обучение ни одной из моделей и содержит оба класса. Отсутствие независимой разметки, неизвестное происхождение контроля или ошибка расчёта блокируют публикацию.
ROC-AUC считается по непрерывной степени аномальности. В проекте score = IsolationForest.decision_function, меньшее значение означает большую аномальность, поэтому для положительного класса «аномалия» используется -score. Бинарные is_anomaly и собственные предсказания модели не заменяют независимую разметку.
При наличии пригодной прежней модели кандидат допускается к ручной валидации только если AUC_new &gt; AUC_old, AUC_new &gt;= AUC_min и остальные обязательные проверки пройдены. При равенстве или меньшем AUC новая версия не публикуется; сохранение прежней рабочей версии подтверждается подпроцессом восстановления.
AUC_min, достаточный объём контроля и правила сценариев утверждаются до оценки кандидата. Численные значения порогов в этой работе не устанавливались; пример 0,8 из лекции не выдаётся за обоснованный порог DB Monitor.
При первом запуске или отсутствии пригодной прежней версии сравнительный AUC не вычисляется: отсутствие базы фиксируется. AUC кандидата и абсолютные критерии, утверждённые заранее, всё равно обязательны; инженер отдельно одобряет первый допуск.
Дополнительные сценарии: нормальный ряд без чрезмерного числа тревог и обнаружение известного всплеска; контроль соответствует масштабу конкретной таблицы. Предварительные ограничения из исходного предложения требуют проверки и утверждения инженером. Небольшая разница AUC сама по себе не доказывает устойчивого улучшения.
Синтетический независимый контроль допустим как явно обозначенный учебный сценарий; его результат не подтверждает эксплуатационное качество. Пригодность сценариев утверждает инженер до использования в допуске.
После автоматического допуска обязательно явное одобрение инженера (User Task). Ожидание ответа не является одобрением; отсутствие AUC нельзя обойти ручным согласием.
Это проект процесса: контрольная разметка не подготовлена, модели не обучались и значения AUC не измерялись в рамках подготовки схемы.</bpmn:documentation>
        <bpmn:incoming>Publish_F05</bpmn:incoming>
        <bpmn:outgoing>Publish_F06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_Quality_OK" name="Кандидат выбран по AUC&#10;и проверки пройдены?" gatewayDirection="Diverging" default="Publish_F08">
        <bpmn:incoming>Publish_F06</bpmn:incoming>
        <bpmn:outgoing>Publish_F07</bpmn:outgoing>
        <bpmn:outgoing>Publish_F08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P_Review" name="5. Проверить данные,&#10;метрики и ограничения;&#10;одобрить или отклонить">
        <bpmn:documentation>Обязательная валидация человеком после автоматического допуска. Инженер изучает независимость и разметку контроля, сравнение ROC-AUC, сценарии, ложные тревоги, величину прироста и ограничения. Для первого запуска проверяет выполнение заранее утверждённых абсолютных критериев. Сохраняет решение и обоснование. Отсутствие AUC нельзя одобрить в обход обязательной проверки. До решения процесс ожидает; ожидание не является согласием. Рабочая оценка при этом не приостанавливается.</bpmn:documentation>
        <bpmn:incoming>Publish_F07</bpmn:incoming>
        <bpmn:outgoing>Publish_F09</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P_Approved" name="Инженер&#10;одобрил?" gatewayDirection="Diverging" default="Publish_F11">
        <bpmn:incoming>Publish_F09</bpmn:incoming>
        <bpmn:outgoing>Publish_F10</bpmn:outgoing>
        <bpmn:outgoing>Publish_F11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P_Register" name="6. Сохранить версию,&#10;метаданные, отчёт&#10;и решение инженера" implementation="##unspecified">
        <bpmn:documentation>Отдельный артефакт модели и scaler; проект/таблица; версии кода и библиотек; границы выборок; параметры; результаты контроля; автор и время валидации. Хранить прежние версии.</bpmn:documentation>
        <bpmn:incoming>Publish_F10</bpmn:incoming>
        <bpmn:outgoing>Publish_F12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Window" name="7. Проверить артефакт;&#10;приостановить оценку;&#10;задать окно 14 дней" implementation="##unspecified">
        <bpmn:documentation>Выполнять только после явного одобрения инженера и регистрации версии. Проверить загрузку артефакта и контракт признаков. Для пары приостановить обычную оценку и смену версии, дождаться начатых операций и проверить актуальность решения и исходного контекста. Затем взять текущее время конца окна и последние 14 дней перед ним. До попытки переключения сохранить границы окна и прежнюю версию в контексте восстановления. Ошибка проверки или сохранения запрещает переключение и передаётся как BPMN Error. На повторе восстановления использовать сохранённые границы, не выбирать новое окно.</bpmn:documentation>
        <bpmn:incoming>Publish_F12</bpmn:incoming>
        <bpmn:outgoing>Publish_F13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Deploy" name="7. Переключить версию;&#10;подтвердить результат" implementation="##unspecified">
        <bpmn:documentation>Под сохраняющейся блокировкой повторно подтвердить неизменность одобренного контекста, использовать сохранённое окно и переключить активный указатель. Подтвердить фактически выбранную версию. Ошибку или неизвестный результат передать как BPMN Error. Рабочая версия не меняется, пока окно не сохранено.</bpmn:documentation>
        <bpmn:incoming>Publish_F13</bpmn:incoming>
        <bpmn:outgoing>Publish_F14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Scores" name="7. Пересчитать и сохранить&#10;фиксированное окно&#10;14 дней" implementation="##unspecified">
        <bpmn:documentation>Служебный пересчёт выбранной моделью только за окно, сохранённое перед переключением после решения инженера. Подтвердить полноту, принадлежность результатов версии, проекту, таблице и этому окну. Не смешивать результаты разных моделей.</bpmn:documentation>
        <bpmn:incoming>Publish_F14</bpmn:incoming>
        <bpmn:outgoing>Publish_F15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_Coherent" name="Оценки&#10;согласованы?" gatewayDirection="Diverging" default="Publish_F17">
        <bpmn:incoming>Publish_F15</bpmn:incoming>
        <bpmn:outgoing>Publish_F16</bpmn:outgoing>
        <bpmn:outgoing>Publish_F17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P_Resume" name="Разрешить обычную оценку" implementation="##unspecified">
        <bpmn:incoming>Publish_F16</bpmn:incoming>
        <bpmn:outgoing>Publish_F18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="P_End" name="Новая версия и оценки&#10;подтверждены">
        <bpmn:incoming>Publish_F18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P_RejectData" name="Данные / разметка&#10;не допущены">
        <bpmn:documentation>BPMN Error RetrainRejected. Прерывает подпроцесс Publish; перехватывается событием Publish_Error на схеме 01. Ошибки сервисных задач также передаются в BPMN Error и перехватываются там.</bpmn:documentation>
        <bpmn:incoming>Publish_F04</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_RejectData_Definition" errorRef="Error_Rejected"/>
      </bpmn:endEvent>
      <bpmn:endEvent id="P_RejectQuality" name="Кандидат не лучше /&#10;проверки не пройдены">
        <bpmn:documentation>BPMN Error RetrainRejected. Прерывает подпроцесс Publish; перехватывается событием Publish_Error на схеме 01. Ошибки сервисных задач также передаются в BPMN Error и перехватываются там.</bpmn:documentation>
        <bpmn:incoming>Publish_F08</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_RejectQuality_Definition" errorRef="Error_Rejected"/>
      </bpmn:endEvent>
      <bpmn:endEvent id="P_RejectHuman" name="Инженер отклонил&#10;публикацию">
        <bpmn:documentation>BPMN Error RetrainRejected. Прерывает подпроцесс Publish; перехватывается событием Publish_Error на схеме 01. Ошибки сервисных задач также передаются в BPMN Error и перехватываются там.</bpmn:documentation>
        <bpmn:incoming>Publish_F11</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_RejectHuman_Definition" errorRef="Error_Rejected"/>
      </bpmn:endEvent>
      <bpmn:endEvent id="P_RejectScores" name="Оценки&#10;не согласованы">
        <bpmn:documentation>BPMN Error RetrainRejected. Прерывает подпроцесс Publish; перехватывается событием Publish_Error на схеме 01. Ошибки сервисных задач также передаются в BPMN Error и перехватываются там.</bpmn:documentation>
        <bpmn:incoming>Publish_F17</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_RejectScores_Definition" errorRef="Error_Rejected"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Publish_F01" sourceRef="P_Start" targetRef="P_Data"/>
      <bpmn:sequenceFlow id="Publish_F02" sourceRef="P_Data" targetRef="P_Data_OK"/>
      <bpmn:sequenceFlow id="Publish_F03" sourceRef="P_Data_OK" targetRef="P_Train" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Корректность и достаточность обучения, независимость размеченного контроля с обоими классами и наличие предварительно утверждённых правил допуска подтверждены</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Publish_F04" sourceRef="P_Data_OK" targetRef="P_RejectData" name="Нет"/>
      <bpmn:sequenceFlow id="Publish_F05" sourceRef="P_Train" targetRef="P_Quality"/>
      <bpmn:sequenceFlow id="Publish_F06" sourceRef="P_Quality" targetRef="P_Quality_OK"/>
      <bpmn:sequenceFlow id="Publish_F07" sourceRef="P_Quality_OK" targetRef="P_Review" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">AUC кандидата рассчитан и не ниже заранее утверждённого AUC_min; все обязательные проверки пройдены; при наличии пригодной прежней модели AUC кандидата строго больше её AUC на том же контроле. При первом запуске сравнение отсутствует и явно зафиксировано, абсолютный контроль обязателен.</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Publish_F08" sourceRef="P_Quality_OK" targetRef="P_RejectQuality" name="Нет"/>
      <bpmn:sequenceFlow id="Publish_F09" sourceRef="P_Review" targetRef="P_Approved"/>
      <bpmn:sequenceFlow id="Publish_F10" sourceRef="P_Approved" targetRef="P_Register" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Инженер сохранил явное одобрение</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Publish_F11" sourceRef="P_Approved" targetRef="P_RejectHuman" name="Нет"/>
      <bpmn:sequenceFlow id="Publish_F12" sourceRef="P_Register" targetRef="P_Window"/>
      <bpmn:sequenceFlow id="Publish_F13" sourceRef="P_Window" targetRef="P_Deploy"/>
      <bpmn:sequenceFlow id="Publish_F14" sourceRef="P_Deploy" targetRef="P_Scores"/>
      <bpmn:sequenceFlow id="Publish_F15" sourceRef="P_Scores" targetRef="P_Coherent"/>
      <bpmn:sequenceFlow id="Publish_F16" sourceRef="P_Coherent" targetRef="P_Resume" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Полнота и принадлежность всех оценок подтверждены</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Publish_F17" sourceRef="P_Coherent" targetRef="P_RejectScores" name="Нет"/>
      <bpmn:sequenceFlow id="Publish_F18" sourceRef="P_Resume" targetRef="P_End"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Publish_Error" name="Ошибка / отказ" attachedToRef="Publish" cancelActivity="true">
      <bpmn:outgoing>Process_Retrain_F12</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Publish_Error_Definition"/>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="Recover" name="8. Восстановить безопасное&#10;состояние модели и оценок&#10;Подробности — схема 03">
      <bpmn:documentation>Встроенный подпроцесс с четырьмя возможными исходами R1–R4. Перед переключением режима подтверждается фактическое состояние.</bpmn:documentation>
      <bpmn:incoming>Process_Retrain_F13</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F14</bpmn:outgoing>
      <bpmn:startEvent id="R_Start" name="Вход из схемы 01">
        <bpmn:outgoing>Recover_F01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="R_Pause" name="Приостановить обычную оценку&#10;и смену версии; дождаться&#10;начатых операций" implementation="##unspecified">
        <bpmn:documentation>Блокировка для пары проект/таблица должна быть подтверждена. Служебное восстановление разрешено. Если подтвердить блокировку нельзя, требуется операционный инцидент вне гарантируемых R1–R4; модель не объявляется безопасной.</bpmn:documentation>
        <bpmn:incoming>Recover_F01</bpmn:incoming>
        <bpmn:outgoing>Recover_F02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="R_Inspect" name="Записать причину отказа;&#10;определить активную версию&#10;и пригодность прежней" implementation="##unspecified">
        <bpmn:documentation>Прежняя версия — модель до попытки обновления, не кандидат. Проверить загрузку, проект/таблицу и контракт признаков. Неудача чтения указателя сохраняется как неизвестное состояние; отсутствие доказательства пригодности означает ветку Нет.</bpmn:documentation>
        <bpmn:incoming>Recover_F02</bpmn:incoming>
        <bpmn:outgoing>Recover_F03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_Previous" name="Прежняя модель&#10;есть и пригодна?" gatewayDirection="Diverging" default="Recover_F05">
        <bpmn:incoming>Recover_F03</bpmn:incoming>
        <bpmn:outgoing>Recover_F04</bpmn:outgoing>
        <bpmn:outgoing>Recover_F05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Select" name="Подтвердить или восстановить&#10;выбор прежней версии;&#10;проверить загрузку" implementation="##unspecified">
        <bpmn:documentation>Если прежняя версия уже выбрана, подтвердить выбор без лишнего переключения. Иначе восстановить указатель. Ошибки операции и проверки возвращаются статусом; отдельно записать ошибку восстановления модели.</bpmn:documentation>
        <bpmn:incoming>Recover_F04</bpmn:incoming>
        <bpmn:outgoing>Recover_F06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_Loaded" name="Прежняя версия&#10;выбрана и загружается?" gatewayDirection="Diverging" default="Recover_F08">
        <bpmn:incoming>Recover_F06</bpmn:incoming>
        <bpmn:outgoing>Recover_F07</bpmn:outgoing>
        <bpmn:outgoing>Recover_F08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Scores" name="Проверить прежние оценки;&#10;при необходимости пересчитать&#10;исходное окно 14 дней" implementation="##unspecified">
        <bpmn:documentation>Использовать сохранённое окно этой попытки. Если до переключения окно ещё не было задано и подтверждено отсутствие попытки активации, определить последние 14 дней после остановки операций и сохранить границы для повторов. После возможного переключения неизвестное окно нельзя подменять новым: согласованность не подтверждена, требуется R2 при доступной прежней модели. Если оценки уже полны и согласованы с прежней версией и сохранённым окном, не пересчитывать; иначе пересчитать его без сдвига границ. Ошибки проверки, пересчёта или записи также возвращаются как неподтверждённая согласованность.</bpmn:documentation>
        <bpmn:incoming>Recover_F07</bpmn:incoming>
        <bpmn:outgoing>Recover_F16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_Coherent" name="Оценки прежней модели&#10;согласованы?" gatewayDirection="Diverging" default="Recover_F18">
        <bpmn:incoming>Recover_F16</bpmn:incoming>
        <bpmn:outgoing>Recover_F17</bpmn:outgoing>
        <bpmn:outgoing>Recover_F18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Resume" name="Разрешить обычную оценку;&#10;зафиксировать R1" implementation="##unspecified">
        <bpmn:incoming>Recover_F17</bpmn:incoming>
        <bpmn:outgoing>Recover_F19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="R_End1" name="R1: прежняя модель&#10;и оценки подтверждены;&#10;обычная оценка разрешена">
        <bpmn:incoming>Recover_F19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="R_LogScores" name="Записать ошибку оценок;&#10;сохранить блокировку;&#10;зафиксировать R2" implementation="##unspecified">
        <bpmn:incoming>Recover_F18</bpmn:incoming>
        <bpmn:outgoing>Recover_F20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="R_End2" name="R2: прежняя модель доступна;&#10;оценки не согласованы;&#10;обычная оценка заблокирована">
        <bpmn:incoming>Recover_F20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="R_MergeOff" gatewayDirection="Converging">
        <bpmn:incoming>Recover_F05</bpmn:incoming>
        <bpmn:incoming>Recover_F08</bpmn:incoming>
        <bpmn:outgoing>Recover_F09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Disable" name="Снять активный выбор;&#10;записать ошибку отключения,&#10;если операция не удалась" implementation="##unspecified">
        <bpmn:documentation>Запретить использование кандидата. Артефакт можно сохранить для разбора. Ошибка отключения записывается отдельно, но не отменяет следующую проверку фактического указателя. Блокировка обычных операций сохраняется.</bpmn:documentation>
        <bpmn:incoming>Recover_F09</bpmn:incoming>
        <bpmn:outgoing>Recover_F10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="R_Read" name="Повторно прочитать&#10;фактический активный указатель" implementation="##unspecified">
        <bpmn:documentation>Вернуть подтверждённое отсутствие версии, фактически выбранную версию либо неизвестное состояние. Ошибка чтения не означает успешное отключение.</bpmn:documentation>
        <bpmn:incoming>Recover_F10</bpmn:incoming>
        <bpmn:outgoing>Recover_F11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_Empty" name="Отсутствие активной&#10;модели подтверждено?" gatewayDirection="Diverging" default="Recover_F13">
        <bpmn:incoming>Recover_F11</bpmn:incoming>
        <bpmn:outgoing>Recover_F12</bpmn:outgoing>
        <bpmn:outgoing>Recover_F13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Set3" name="Зафиксировать R3;&#10;сохранить блокировку" implementation="##unspecified">
        <bpmn:incoming>Recover_F12</bpmn:incoming>
        <bpmn:outgoing>Recover_F14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="R_Set4" name="Записать фактическую версию&#10;или неизвестное состояние;&#10;сохранить блокировку; R4" implementation="##unspecified">
        <bpmn:incoming>Recover_F13</bpmn:incoming>
        <bpmn:outgoing>Recover_F15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="R_End3" name="R3: активной модели нет;&#10;согласованных оценок нет;&#10;обычная оценка заблокирована">
        <bpmn:incoming>Recover_F14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="R_End4" name="R4: отключение&#10;не подтверждено;&#10;обычная оценка заблокирована">
        <bpmn:incoming>Recover_F15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Recover_F01" sourceRef="R_Start" targetRef="R_Pause"/>
      <bpmn:sequenceFlow id="Recover_F02" sourceRef="R_Pause" targetRef="R_Inspect"/>
      <bpmn:sequenceFlow id="Recover_F03" sourceRef="R_Inspect" targetRef="R_Previous"/>
      <bpmn:sequenceFlow id="Recover_F04" sourceRef="R_Previous" targetRef="R_Select" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Прежний артефакт существует и его пригодность подтверждена</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Recover_F05" sourceRef="R_Previous" targetRef="R_MergeOff" name="Нет / не подтверждено"/>
      <bpmn:sequenceFlow id="Recover_F06" sourceRef="R_Select" targetRef="R_Loaded"/>
      <bpmn:sequenceFlow id="Recover_F07" sourceRef="R_Loaded" targetRef="R_Scores" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Выбор и загрузка прежней модели подтверждены</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Recover_F08" sourceRef="R_Loaded" targetRef="R_MergeOff" name="Нет / ошибка — записать в журнал"/>
      <bpmn:sequenceFlow id="Recover_F09" sourceRef="R_MergeOff" targetRef="R_Disable"/>
      <bpmn:sequenceFlow id="Recover_F10" sourceRef="R_Disable" targetRef="R_Read"/>
      <bpmn:sequenceFlow id="Recover_F11" sourceRef="R_Read" targetRef="R_Empty"/>
      <bpmn:sequenceFlow id="Recover_F12" sourceRef="R_Empty" targetRef="R_Set3" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Повторное чтение подтвердило отсутствие выбранной модели</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Recover_F13" sourceRef="R_Empty" targetRef="R_Set4" name="Нет / неизвестно"/>
      <bpmn:sequenceFlow id="Recover_F14" sourceRef="R_Set3" targetRef="R_End3"/>
      <bpmn:sequenceFlow id="Recover_F15" sourceRef="R_Set4" targetRef="R_End4"/>
      <bpmn:sequenceFlow id="Recover_F16" sourceRef="R_Scores" targetRef="R_Coherent"/>
      <bpmn:sequenceFlow id="Recover_F17" sourceRef="R_Coherent" targetRef="R_Resume" name="Да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Сохранённое окно подтверждено; оценки полны и принадлежат прежней версии и этому окну</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Recover_F18" sourceRef="R_Coherent" targetRef="R_LogScores" name="Нет / ошибка"/>
      <bpmn:sequenceFlow id="Recover_F19" sourceRef="R_Resume" targetRef="R_End1"/>
      <bpmn:sequenceFlow id="Recover_F20" sourceRef="R_LogScores" targetRef="R_End2"/>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Notify_Success" name="Зафиксировать новую версию;&#10;уведомить инженера&#10;в Telegram" implementation="##unspecified">
      <bpmn:documentation>После успешной публикации отправить версию, результаты проверок и решение инженера в настроенный Telegram. Ограничить ожидание доставки; ошибку или отсутствие настройки явно записать. Ошибка уведомления не отменяет успешный деплой. Для фактической доставки необходима настроенная интеграция.</bpmn:documentation>
      <bpmn:incoming>Process_Retrain_F10</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Success" name="Новая модель доступна;&#10;оценки согласованы;&#10;обычная оценка разрешена">
      <bpmn:incoming>Process_Retrain_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Notify" name="Зафиксировать исход R1–R4;&#10;попробовать уведомить&#10;инженера в Telegram" implementation="##unspecified">
      <bpmn:documentation>Сначала сохранить результат обработки. Уведомление при настроенном Telegram: ограниченное ожидание, ошибки доставки возвращаются статусом и записываются; отсутствие настройки также фиксируется. Уведомление не меняет исход восстановления и не снимает блокировку.</bpmn:documentation>
      <bpmn:incoming>Process_Retrain_F14</bpmn:incoming>
      <bpmn:outgoing>Process_Retrain_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Handled" name="Обработка отказа завершена;&#10;фактический исход — R1–R4&#10;(см. схему 03)">
      <bpmn:incoming>Process_Retrain_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Process_Retrain_F01" sourceRef="Start_Timer" targetRef="Merge_Start"/>
    <bpmn:sequenceFlow id="Process_Retrain_F02" sourceRef="Start_Manual" targetRef="Merge_Start"/>
    <bpmn:sequenceFlow id="Process_Retrain_F03" sourceRef="Start_Missing" targetRef="Merge_Start"/>
    <bpmn:sequenceFlow id="Process_Retrain_F04" sourceRef="Start_Change" targetRef="Merge_Start"/>
    <bpmn:sequenceFlow id="Process_Retrain_F05" sourceRef="Merge_Start" targetRef="Inspect"/>
    <bpmn:sequenceFlow id="Process_Retrain_F06" sourceRef="Inspect" targetRef="Pending"/>
    <bpmn:sequenceFlow id="Process_Retrain_F07" sourceRef="Inspect_Error" targetRef="Merge_Failure"/>
    <bpmn:sequenceFlow id="Process_Retrain_F08" sourceRef="Pending" targetRef="Publish" name="Нет"/>
    <bpmn:sequenceFlow id="Process_Retrain_F09" sourceRef="Pending" targetRef="Merge_Failure" name="Да: R2 / R4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Предыдущий исход R2 или R4: восстановление не завершено</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Retrain_F10" sourceRef="Publish" targetRef="Notify_Success"/>
    <bpmn:sequenceFlow id="Process_Retrain_F11" sourceRef="Notify_Success" targetRef="End_Success"/>
    <bpmn:sequenceFlow id="Process_Retrain_F12" sourceRef="Publish_Error" targetRef="Merge_Failure"/>
    <bpmn:sequenceFlow id="Process_Retrain_F13" sourceRef="Merge_Failure" targetRef="Recover"/>
    <bpmn:sequenceFlow id="Process_Retrain_F14" sourceRef="Recover" targetRef="Notify"/>
    <bpmn:sequenceFlow id="Process_Retrain_F15" sourceRef="Notify" targetRef="End_Handled"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Retrain">
    <bpmn:participant id="Participant_DBMonitor" name="DB Monitor — управление моделями" processRef="Process_Retrain"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Process_Retrain_Diagram" name="01 / Автоматическое переобучение">
    <bpmndi:BPMNPlane id="Process_Retrain_Plane" bpmnElement="Collaboration_Retrain">
      <bpmndi:BPMNShape id="Participant_DBMonitor_DI" bpmnElement="Participant_DBMonitor" isHorizontal="false">
        <dc:Bounds x="40" y="130" width="1140" height="1170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Timer_DI" bpmnElement="Start_Timer">
        <dc:Bounds x="140" y="280" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="70" y="220" width="180" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Manual_DI" bpmnElement="Start_Manual">
        <dc:Bounds x="390" y="280" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="320" y="220" width="180" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Missing_DI" bpmnElement="Start_Missing">
        <dc:Bounds x="640" y="280" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="220" width="220" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Change_DI" bpmnElement="Start_Change">
        <dc:Bounds x="890" y="280" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="220" width="240" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_Start_DI" bpmnElement="Merge_Start" isMarkerVisible="true">
        <dc:Bounds x="383" y="383" width="54" height="54"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inspect_DI" bpmnElement="Inspect">
        <dc:Bounds x="270" y="460" width="280" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inspect_Error_DI" bpmnElement="Inspect_Error">
        <dc:Bounds x="530" y="500" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="500" width="90" height="25"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pending_DI" bpmnElement="Pending" isMarkerVisible="true">
        <dc:Bounds x="383" y="608" width="54" height="54"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="125" y="605" width="240" height="60"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_Failure_DI" bpmnElement="Merge_Failure" isMarkerVisible="true">
        <dc:Bounds x="873" y="608" width="54" height="54"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Publish_DI" bpmnElement="Publish" isExpanded="false">
        <dc:Bounds x="270" y="745" width="280" height="110"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Publish_Error_DI" bpmnElement="Publish_Error">
